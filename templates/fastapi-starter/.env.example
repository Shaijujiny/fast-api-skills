# Copy to .env. Never commit .env.
# SQL backend: mysql | postgresql (see app/database/). Configure the matching block below.
DB_TYPE=mysql
# Optional full-URL override, e.g. sqlite:///./app.db for dev/tests
DATABASE_URL=sqlite:///./app.db
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=app
# MYSQL_PASSWORD=
# MYSQL_NAME=app
# POSTGRESQL_HOST=localhost
# POSTGRESQL_PORT=5432
# POSTGRESQL_USER=app
# POSTGRESQL_PASSWORD=
# POSTGRESQL_NAME=app
# MongoDB (opt-in, pip install pymongo; separate from the SQL stack)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_NAME=app
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=["http://localhost:3000"]
DEFAULT_LANGUAGE=en
LOG_LEVEL=INFO
REFRESH_TOKEN_EXPIRE_DAYS=14
# Set to use the Redis rate-limit backend (pip install redis); empty = in-memory (single process)
# REDIS_URL=redis://localhost:6379/0
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT=30
REFRESH_RATE_WINDOW_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PERMISSION_CACHE_TTL_SECONDS=30
