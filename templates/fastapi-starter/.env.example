# Copy to .env. Never commit .env.
# sqlite for dev/tests; use mysql+pymysql://user:pass@host/db or postgresql+psycopg://user:pass@host/db in prod
DATABASE_URL=sqlite:///./app.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
CORS_ORIGINS=["http://localhost:3000"]
DEFAULT_LANGUAGE=en
LOG_LEVEL=INFO
REFRESH_TOKEN_EXPIRE_DAYS=14
# Set to use the Redis rate-limit backend (pip install redis); empty = in-memory (single process)
# REDIS_URL=redis://localhost:6379/0
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT=30
REFRESH_RATE_WINDOW_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PERMISSION_CACHE_TTL_SECONDS=30
